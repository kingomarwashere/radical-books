# ── Radical Books config ──────────────────────────────────────────────
PORT=3030
NODE_ENV=production
SITE_URL=https://books.theradicalparty.com
SESSION_SECRET=change-me
ADMIN_USERS=potato,admin

# Storage: mirror public-domain media into our R2/CDN (1) or hotlink the source (0).
# Reuses the shared Radical R2 worker + cdn.theradicalparty.com with a books/ prefix.
MIRROR_TO_R2=1
R2_UPLOAD_URL=https://radical-movies-r2.omar-c29.workers.dev
R2_CDN_URL=https://cdn.theradicalparty.com
R2_UPLOAD_SECRET=
R2_KEY_PREFIX=books

# Stripe (same account as Radical Movies / Sound) — fill on deploy.
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_ANNUAL=
STRIPE_CURRENCY=aud

# Promo-link generator secret (x-gen-key)
GEN_KEY=
